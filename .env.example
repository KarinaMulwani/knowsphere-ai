# =============================================================================
# KnowSphere AI - Environment Variables
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── NVIDIA NIM ───────────────────────────────────────────────────────────────
# Get your key from https://build.nvidia.com → Account → API Keys
# Base URL: https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-your-nvidia-api-key

# ── Chat Model Configuration ─────────────────────────────────────────────────
# Primary model (fast, high-quality, verified 200 OK on NVIDIA NIM).
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Fallback model (verified active on NVIDIA NIM).
NVIDIA_FALLBACK_MODEL=google/diffusiongemma-26b-a4b-it
# Second fallback for additional resilience.
NVIDIA_FALLBACK_MODEL_2=nvidia/nemotron-3.5-lightning-30b-a3b

# ── Embedding Model Configuration ────────────────────────────────────────────
# NVIDIA embedding model (verified 200 OK on NVIDIA NIM).
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
NVIDIA_EMBEDDING_DIMENSION=2048

# ── RAG / Retrieval Settings ─────────────────────────────────────────────────
# Maximum number of chunks to retrieve per query.
RAG_TOP_K=5
# Minimum cosine similarity score (0-1). Chunks below this are filtered out.
RAG_SIMILARITY_THRESHOLD=0.3
# Default chunk size in characters.
CHUNK_SIZE=1000
# Overlap between consecutive chunks in characters.
CHUNK_OVERLAP=200
